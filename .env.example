# Alamat API Back-End.
# Lokal      : http://localhost:3000/api
# Produksi   : https://<project-backend>.vercel.app/api   (akhiran /api boleh ditulis atau tidak)
VITE_API_URL=http://localhost:3000/api

# Kunci Google Maps JavaScript API (lihat README untuk cara membuatnya).
# Tanpa kunci ini aplikasi tetap jalan: peta otomatis memakai OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
